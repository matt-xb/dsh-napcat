{
  "name": "dsh-napcat",
  "version": "0.3.23-xb.8",
  "description": "NapCat / OneBot 11 通道插件：把 DeepSeek Harness 变成 QQ 机器人（私聊 + 群聊、@门控、白名单、长文分段、工具主动发送、设置页配置）。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "keywords": ["dsh", "deepseek-harness", "harness", "napcat", "onebot", "onebot11", "qq", "qqbot", "channel", "chatbot"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/matt-xb/dsh-napcat.git" },
  "homepage": "https://github.com/matt-xb/dsh-napcat#readme",
  "bugs": { "url": "https://github.com/matt-xb/dsh-napcat/issues" },
  "engines": { "dsh": ">=0.2.1-0 <0.3.0-0", "node": ">=22" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": { "ws": "^8.18.0" },
  "optionalDependencies": { "@xenova/transformers": "^2.17.2" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  }
}